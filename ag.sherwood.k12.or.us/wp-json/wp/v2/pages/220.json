{"id":220,"date":"2020-06-26T08:29:37","date_gmt":"2020-06-26T08:29:37","guid":{"rendered":"https:\/\/ag.sherwood.k12.or.us\/?page_id=220"},"modified":"2025-12-12T08:48:37","modified_gmt":"2025-12-12T16:48:37","slug":"media-center","status":"publish","type":"page","link":"https:\/\/ag.sherwood.k12.or.us\/resources\/media-center\/","title":{"rendered":"Media Center"},"content":{"rendered":"<div class=\"wp-block-image is-style-rounded\">\n<figure class=\"aligncenter size-large is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2020\/05\/archer-glen-logo.svg\" alt=\"Archer Glen Eagle mascot\" class=\"wp-image-12\" width=\"149\" height=\"140\" \/><\/figure><\/div>\n\n\n<h2 class=\"wp-block-heading\">Archer Glen Elementary Media Center<\/h2>\n\n\n\n<p class=\"has-text-align-center\" style=\"font-size:23px;line-height:1.7\"><strong>Carrie Steele <\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center\"><strong>Media Center Educational Coordinator<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center\"><strong>503 825-5109<\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center\"><strong><a href=\"mailto:csteele@sherwood.k12.or.us\" target=\"_blank\" rel=\"noreferrer noopener\">csteele@sherwood.k12.or.us<\/a><\/strong><\/p>\n\n\n\n<p><\/p>\n\n\n\n<p class=\"has-text-align-center has-text-color has-medium-font-size\" style=\"color:#1c2445\"><a href=\"https:\/\/sherwood.k12.or.us\/departments\/teaching-and-learning\/media-center-library-services\/\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>SSD Library Media Center Policies<\/strong><\/a><\/p>\n\n\n\n<p class=\"has-medium-font-size\">&nbsp;<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/12\/image-1024x1024.png\" alt=\"Three children standing in the snow reading\" class=\"wp-image-1512\" width=\"324\" height=\"324\" srcset=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/12\/image-1024x1024.png 1024w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/12\/image-300x300.png 300w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/12\/image-150x150.png 150w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/12\/image-768x768.png 768w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/12\/image.png 1080w\" sizes=\"(max-width: 324px) 100vw, 324px\" \/><\/figure><\/div>\n\n\n<div style=\"height:55px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<h2 class=\"wp-block-heading has-medium-font-size\">Books &amp; Bricks Winter Reading Program &#8211; December 20, 2025 &#8211; January 9th, 2026<\/h2>\n\n\n\n<p><\/p>\n\n\n\n<h2 class=\"wp-block-heading has-medium-font-size\">Reading Logs are available to print below <br><\/h2>\n\n\n\n<p class=\"has-primary-color has-text-color has-medium-font-size\"><a href=\"https:\/\/drive.google.com\/file\/d\/1z45YCcSCf259bIJF04Z0shblaCbVKbaN\/view?usp=drive_link\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>2025\/26 Books &amp; Bricks Winter Reading Log<\/strong><\/a><\/p>\n\n\n\n<p class=\"has-primary-color has-text-color has-medium-font-size\"><a href=\"https:\/\/drive.google.com\/file\/d\/1duqz5SNX6lG_gZ91KF9JkozZ9KFJmPNJ\/view?usp=drive_link\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>2025\/26 Libros y bloques Lectura de invierno para j\ufb1eovenes<\/strong><\/a><\/p>\n\n\n\n<p class=\"has-medium-font-size\"><\/p>\n\n\n\n<div style=\"height:21px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div style=\"height:28px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<p class=\"has-text-align-center has-text-color has-large-font-size\" style=\"color:#0a2d3d\"><strong><a href=\"https:\/\/search.follettsoftware.com\/metasearch\/ui\/31658\" data-type=\"https:\/\/search.follettsoftware.com\/metasearch\/ui\/31658\"><span class=\"has-inline-color has-primary-color\">Destiny Library System<\/span><\/a><\/strong><\/p>\n\n\n\n<p class=\"has-text-align-center\" style=\"line-height:0\"> <\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/3\/2020\/09\/website-library-books-1.jpeg\" alt=\"Students reading.\" width=\"391\" height=\"196\" \/><\/figure><\/div>\n\n\n<p class=\"has-text-align-center has-text-color has-large-font-size\" style=\"color:#5199db\"><\/p>\n\n\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<figure class=\"wp-block-image size-large is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2022\/05\/tumblebooks-logo-3.png\" alt=\"Tumble Book Library eBooks for eKids logo\" class=\"wp-image-514\" width=\"500\" height=\"282\" srcset=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2022\/05\/tumblebooks-logo-3.png 400w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2022\/05\/tumblebooks-logo-3-300x169.png 300w\" sizes=\"(max-width: 500px) 100vw, 500px\" \/><\/figure>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter\"><img decoding=\"async\" src=\"https:\/\/lh3.googleusercontent.com\/proxy\/UtLG_1IL_NlslL1HJz3z6dJlET_wg25_-2XjOn1732OaBrDZNKI9qKRsCrIZqJW1QEuUSPhdJj0skMBwJN4myRbvNxwMweocL7u_lr1eAsPoR-DhUGx2cgL3XBcHddDHOrmooJ2e\" alt=\"Tumble Books: Interactive Books for Kids! \u2013 Boonton Holmes Public Library\" \/><figcaption class=\"wp-element-caption\"><a href=\"https:\/\/www.tumblebooklibrary.com\/Default.aspx?ReturnUrl=%2f\"><strong>Tumble Books<\/strong><\/a><br>Watch, listen, and read along with animated picture books and e-books for new readers with&nbsp;<a href=\"http:\/\/www.tumblemobile.com\/autologin.aspx?UserID=9%2BKxCHgEs8fiRK48SFvwow%3D%3D\">Tumblebook Library<\/a>.<br>TumbleBooks e-books have several features to adapt the text for students who are struggling to learn to read and students with reading disabilities.<br>For example: Listen to the e-book as the text is highlighted, change the colors and contrast of text on the page, and change the font style and size.<\/figcaption><\/figure><\/div>\n\n\n<h4 class=\"wp-block-heading\"><a rel=\"noreferrer noopener\" href=\"http:\/\/www.tumblebooklibrary.com\/auto_login.aspx?u=wccls&amp;p=sherwood\" target=\"_blank\"><span style=\"color:#0002a3\" class=\"has-inline-color\">Click here to access TumbleBook Library.<\/span><\/a><\/h4>\n\n\n\n<p><\/p>\n\n\n\n<h4 class=\"wp-block-heading\"><a rel=\"noreferrer noopener\" href=\"https:\/\/docs.google.com\/document\/d\/1thJqC5zSAKrknB9YGtiY90v8i0S51MmogcwRgyGwJtc\/edit?usp=sharing\" target=\"_blank\"><span style=\"color:#0900a3\" class=\"has-inline-color\">Click here for more information on using TumbleBook Library.<\/span><\/a><\/h4>\n\n\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<p><\/p>\n\n\n\n<h2 class=\"wp-block-heading\"><a href=\"https:\/\/www.storylineonline.net\/\"><strong>Storyline<\/strong><\/a><\/h2>\n\n\n\n<p>Storyline Online is available 24 hours a day for children, parents, caregivers and educators worldwide. Each book includes supplemental curriculum developed by a credentialed elementary educator, aiming to strengthen comprehension and verbal and written skills for English-language learners.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter is-resized\"><a href=\"https:\/\/www.storylineonline.net\/\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/5\/2020\/09\/storybooks-logo.png\" alt=\"Storyline Online\" class=\"wp-image-341\" width=\"452\" height=\"118\" \/><\/a><\/figure><\/div>\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter\"><img decoding=\"async\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/5\/2020\/09\/story-line.jpg\" alt=\"Storyline Online logo\" \/><\/figure><\/div>\n\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image.png\" alt=\"\" class=\"wp-image-1296\" width=\"295\" height=\"324\" srcset=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image.png 365w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image-274x300.png 274w\" sizes=\"(max-width: 295px) 100vw, 295px\" \/><\/figure>\n\n\n\n<p>Chooch Helped- Caldecott Medal Winner 2025<\/p>\n\n\n\n<p>The Caldecott Medal was named in honor of nineteenth-century English illustrator Randolph Caldecott. It is awarded annually by the&nbsp;Association for Library Service to Children, a division of the American Library Association, to the artist of the most distinguished American picture&nbsp;book for children.&nbsp;<\/p>\n\n\n\n<figure class=\"wp-block-image size-large is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image-2-674x1024.png\" alt=\"\" class=\"wp-image-1298\" width=\"247\" height=\"376\" srcset=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image-2-674x1024.png 674w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image-2-197x300.png 197w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image-2-768x1167.png 768w, https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2025\/02\/image-2.png 987w\" sizes=\"(max-width: 247px) 100vw, 247px\" \/><\/figure>\n\n\n\n<p>The First State of Being- Newbery Medal Winner 2025<\/p>\n\n\n\n<p>The Newbery Medal was named for eighteenth-century British bookseller John Newbery. It is awarded annually by the Association for Library Service to Children, a&nbsp;division of the American Library Association, to&nbsp;the author of the most distinguished contribution to&nbsp;American literature for children.<\/p>\n\n\n\n<p><a href=\"https:\/\/www.ala.org\/alsc\/awardsgrants\/bookmedia\/newbery\"><\/a><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><\/h3>\n\n\n\n<h2 class=\"wp-block-heading has-text-align-left\"><a href=\"https:\/\/www.oregonbattleofthebooks.org\/2022-2023-obob-partial-title-list\/\" target=\"_blank\" rel=\"noreferrer noopener\">OBOB&nbsp;<\/a>(Oregon Battle of Books)<\/h2>\n\n\n\n<figure class=\"wp-block-image is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/franklintoolbox.files.wordpress.com\/2015\/09\/obob-pic.jpg\" alt=\"Oregon Battle of the Books logo\" width=\"335\" height=\"258\" \/><\/figure>\n\n\n\n<h2 class=\"wp-block-heading\"><strong>2025-2026 OBOB Title List<\/strong><\/h2>\n\n\n\n<p><strong>3rd to 5th Grade Division<\/strong><\/p>\n\n\n\n<p><\/p>\n\n\n\n<ul>\n<li class=\"has-medium-font-size\"><em>Better with Butter<\/em>&nbsp;by Victoria Piontek \u2013 ISBN 9781338662214<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>The City of Ember<\/em>&nbsp;by Jeanne DuPrau \u2013 ISBN 9780375822742<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Elf Dog and Owl Head<\/em>&nbsp;by M. T. Anderson \u2013 ISBN 9781536235166<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Escape from Mr. Lemoncello\u2019s Library<\/em>&nbsp;by Chris Grabenstein&nbsp; \u2013 ISBN 978059389720&nbsp;<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Finding Langston<\/em>&nbsp;by Lesa Cline-Ransome \u2013 ISBN 9780823445820<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Hatchet<\/em>&nbsp;by Gary Paulsen \u2013 ISBN 9780545462211<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Inside Out and Back Again<\/em>&nbsp;by Thanhh\u00e0 L\u1ea1i \u2013 ISBN 9780061962790<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Just Like Click<\/em>&nbsp;by Sandy Grubb \u2013 ISBN 9781646034390<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>The Lost Library<\/em>&nbsp;by Rebecca Stead and Wendy Mass \u2013 ISBN 9781250838834<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>The Million Dollar Race<\/em>&nbsp;by Matthew Ross Smith \u2013 ISBN 9781534420281<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Number the Stars<\/em>&nbsp;by Lois Lowry \u2013 ISBN 9780547577098<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Odder<\/em>&nbsp;by Katherine Applegate \u2013 ISBN 9781250147424<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>The&nbsp;Remarkable Rescue at Milkweed Meadow<\/em>&nbsp;by Elaine Dimopoulos \u2013 ISBN 9781623545857<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>The Secret Garden on 81st Street<\/em>&nbsp;by Ivy Noelle Weir and Amber Padilla \u2013 ISBN 9780316459709<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>Squished<\/em>&nbsp;by Megan Wagner Lloyd and Michelle Mee Nutter \u2013 ISBN 9781338568936<\/li>\n\n\n\n<li class=\"has-medium-font-size\"><em>The Tail of Emily Windsnap<\/em>&nbsp;by Liz Kessler \u2013 ISBN 9780763660208<\/li>\n<\/ul>\n\n\n\n<p><strong>**<\/strong>&nbsp;<strong>Information is from the Oregon Battle of the books website. **<\/strong><\/p>\n\n\n\n<p><\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><a href=\"https:\/\/docs.google.com\/document\/d\/1a8qTnLmXalI-1TPiQ_zjzwQEmpSyNd4hJ2eWzYKBUFE\/edit?usp=sharing\" target=\"_blank\" rel=\"noreferrer noopener\">OBOB Letter 2025\/2026<\/a><\/h3>\n\n\n\n<h3 class=\"wp-block-heading\"><a href=\"https:\/\/docs.google.com\/document\/d\/13ULIx8khUlegL24-lIHyWqQlCEt3ZhUmGNuKFZmiy5E\/edit?usp=sharing\" target=\"_blank\" rel=\"noreferrer noopener\">Spanish OBOB Letter 2025\/2026<\/a><\/h3>\n\n\n\n<div style=\"height:100px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<p><\/p>\n\n\n\n<figure class=\"wp-block-image is-resized\"><img decoding=\"async\" loading=\"lazy\" src=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/3\/2020\/09\/digital_citizenship-1-1024x583.png\" alt=\"Digital Citizenship\" class=\"wp-image-295\" width=\"441\" height=\"250\" \/><\/figure>\n\n\n\n<p class=\"has-text-align-center\"><strong><a rel=\"noreferrer noopener\" href=\"https:\/\/drive.google.com\/file\/d\/0B6E0-KoNd677SG8tOWtfaWx5WlFjbUw3emtRMnlkeXR2OFJj\/view\" target=\"_blank\">Click here for Digital Citizenship Family Tips<\/a><\/strong><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Archer Glen Elementary Media Center Carrie Steele Media Center Educational Coordinator 503 825-5109 csteele@sherwood.k12.or.us SSD Library Media Center Policies &nbsp; Books &amp; Bricks Winter Reading&#8230;<\/p>\n","protected":false},"author":24,"featured_media":0,"parent":216,"menu_order":30,"comment_status":"closed","ping_status":"closed","template":"","meta":[],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v19.14 - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>Media Center - Archer Glen<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/ag.sherwood.k12.or.us\/resources\/media-center\/\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Media Center - Archer Glen\" \/>\n<meta property=\"og:description\" content=\"Archer Glen Elementary Media Center Carrie Steele Media Center Educational Coordinator 503 825-5109 csteele@sherwood.k12.or.us SSD Library Media Center Policies &nbsp; Books &amp; Bricks Winter Reading...\" \/>\n<meta property=\"og:url\" content=\"https:\/\/ag.sherwood.k12.or.us\/resources\/media-center\/\" \/>\n<meta property=\"og:site_name\" content=\"Archer Glen\" \/>\n<meta property=\"article:modified_time\" content=\"2025-12-12T16:48:37+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/sherwood.k12.or.us\/app\/uploads\/sites\/2\/2020\/05\/archer-glen-logo.svg\" \/>\n<meta name=\"twitter:card\" content=\"summary_large